# Fathom — configuration template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit it, and never
# put a key, hostname, or account detail in a tracked file or in notes/.

# ── Somnia / DreamDEX ───────────────────────────────────────────────────────
# Only needed for Stage 6 (gated testnet execution). Stages 1-5 are read-only
# and run fine with this blank. Use a wallet that holds nothing on any mainnet.
PRIVATE_KEY=

NETWORK=testnet

# The real event-contracts venue (operatorId 2), verified live 2026-08-28.
# These ids MOVE — `npm run snapshot` prints every live venue and marks the
# configured one, so re-check at session start.
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

DRY_RUN=true

# ── LLM provider for the explanation layer ──────────────────────────────────
# Groq is the default: free tier, no card, fast enough for a live demo.
# Get a key at https://console.groq.com/keys
#
# A smaller model is safe here. The explanation layer's output schema has no
# verdict field, so no model can override the risk engine — and four guards plus
# a deterministic fallback reject malformed or dishonest prose rather than
# shipping it. Run `npm run explain -- --offline` to skip the model entirely.
GROQ_API_KEY=

# Optional overrides. LLM_BASE_URL accepts any OpenAI-compatible endpoint
# (OpenRouter, Together, Cerebras, DeepSeek, Ollama) — the same call shape.
# LLM_PROVIDER=groq              # groq | anthropic
# LLM_MODEL=openai/gpt-oss-120b  # must support strict structured outputs
# LLM_BASE_URL=

# ── Analytics (optional) ────────────────────────────────────────────────────
# A self-hosted Umami beacon on the dashboard. Both values describe private
# infrastructure, so they live here blank and nowhere else in the repo.
#
# Next reads env from the app directory, so for a local production run these two
# go in `apps/web/.env.local`; for the deploy they go in the Vercel project's
# environment variables. Leave both blank and `apps/web/components/analytics.tsx`
# renders nothing — the site works identically with no beacon at all.
#
# ANALYTICS_SCRIPT_URL is the full https URL of the tracker script;
# ANALYTICS_WEBSITE_ID is the site's uuid in that Umami instance. Both are
# required together: a script with no site id loads and reports nowhere.
#
# `npm run dev` never reports (the component is gated to NODE_ENV=production),
# so local page loads cannot land in the real stats as `localhost`.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
