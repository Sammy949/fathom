{
  "name": "fathom",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable risk-and-execution copilot for DreamDEX Event Contracts on Somnia.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "snapshot": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/snapshot.ts",
    "capture": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/capture.ts",
    "capture:board": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/capture-board.ts",
    "retry:test": "tsx scripts/retry-test.ts",
    "calibrate": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/calibrate.ts",
    "probe:book": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/probe-book.ts",
    "grade": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/grade.ts",
    "test:risk": "tsx scripts/test-risk.ts",
    "explain": "NODE_OPTIONS=--max-old-space-size=2048 tsx scripts/explain.ts"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
